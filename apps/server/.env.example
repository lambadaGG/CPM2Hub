# GearMarket server

BOT_TOKEN=123456:ABC-DEF...
WEBAPP_URL=https://your-webapp.example.com
# Public HTTPS URL for the Telegram webhook (prod only). Omit to run in polling mode.
PUBLIC_URL=https://your-api.example.com
PORT=8080
# PostgreSQL connection string. For local dev run `docker compose up -d` and use:
DATABASE_URL=postgresql://gearmarket:gearmarket@localhost:5434/gearmarket
# Dev convenience: allow unauthenticated API access when initData absent.
ALLOW_ANON=0
# Comma-separated telegram ids allowed to call admin actions.
ADMIN_IDS=
